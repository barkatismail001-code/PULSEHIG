{
  "openapi": "3.1.0",
  "info": {
    "title": "TechPulse Articles API",
    "version": "1.0.0",
    "description": "Read-only access to TechPulse technical articles."
  },
  "servers": [
    { "url": "https://www.pulsehig.com" }
  ],
  "paths": {
    "/index.html": {
      "get": {
        "summary": "Homepage with latest articles",
        "operationId": "getHome",
        "responses": {
          "200": { "description": "HTML homepage" }
        }
      }
    },
    "/a/{slug}.html": {
      "get": {
        "summary": "Single article by slug",
        "operationId": "getArticle",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "HTML article page" }
        }
      }
    }
  }
}
